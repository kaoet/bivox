/target
# 发布打包产物（scripts/package.ps1 输出），不提交
/dist
# 含 API Key 的本地配置，不提交
/config.toml
# GUI 写回配置前的备份（便携模式运行产物）
/config.toml.bak
# 原子写用的临时文件（写完会 rename 掉；崩溃时可能残留）
/config.toml.tmp
# 便携模式运行产物：日志与崩溃记录（若把 exe 放在仓库根）
/logs/
/crash.log
# 本地共享缓存（音色指纹 -> voice_id、ASR 模型 -> vocabulary_id），本机状态，不提交；
# 不带前导斜杠以匹配任意目录下的缓存文件（含 .tmp/.bak）
cache.json
cache.json.tmp
cache.json.bak
# 本机构建配置（MSVC / Windows SDK 绝对路径），不要提交；模板见 .cargo/config.toml.example
.cargo/config.toml
