# 本地构建配置模板（仓库不提交 .cargo/config.toml，见 CONTRIBUTING 第 1 节）。
#
# 什么时候需要它：cargo 无法自动发现 MSVC 工具链时才用（多版本 Visual Studio
# 共存、报找不到 link.exe / kernel32.lib / 找不到 Windows SDK 等）。做法：
#
#   Copy-Item .cargo\config.toml.example .cargo\config.toml
#
# 然后把下面三个路径改成本机的实际路径。.cargo/config.toml 已被 .gitignore
# 忽略，不要提交——把它提交上来会让别人的构建拿着你的绝对路径去链接。
#
# 路径示例（版本号按自己机器改，用 `vswhere` / 资源管理器确认）：
[target.x86_64-pc-windows-msvc]
linker = "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Tools\\MSVC\\<msvc-version>\\bin\\Hostx64\\x64\\link.exe"
rustflags = [
    "-L", "native=C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Tools\\MSVC\\<msvc-version>\\lib\\x64",
    "-L", "native=C:\\Program Files (x86)\\Windows Kits\\10\\Lib\\<sdk-version>\\ucrt\\x64",
    "-L", "native=C:\\Program Files (x86)\\Windows Kits\\10\\Lib\\<sdk-version>\\um\\x64"
]
